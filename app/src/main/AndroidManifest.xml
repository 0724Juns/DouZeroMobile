<表明xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission安卓：名称="android.permission.FOREGROUND_SERVICE"/>
    <uses-permissionAndroid：名称=“安卓。许可。前景服装介质投影"/>
    <uses-permission安卓：名称="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission安卓：名称="android.permission.POST_NOTIFICATIONS"/>
    <uses-permissionAndroid：名称="android.permission.INTERNET"/>

    <应用
        Android:allowBackup="真"
        安卓：标签=没有任何提示
        安卓：主题="@style/Theme.AppCompat.DayNight.NoActionBar">
        <活动Android：名称=".MainActivity" android:exported="true">
            <意图过滤器>
                <行动Android：名称="android.intent.action.MAIN" />
                <类别Android：名称="android.intent.category.Launcher" />
            </意图过滤器>
        </活动>
        <服务Android：名称=".ScreenCaptureService" android:foregroundServiceType="mediaProjection" android:exported="false" />
        <服务Android：名称=".OverlayService" android:exported="false" />
    </应用>
    </表明>
